---
// src/layouts/BaseLayout.astro
import Sidebar from '../components/Sidebar.vue';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
}
const { title } = Astro.props;

// 記事一覧を取得し、Sidebar（Vueアイランド）に渡せる形（JSONシリアライズ可能な形）に変換
const posts = await getCollection('posts');
const articles = posts.map((post) => {
  const [category, slug] = post.id.split('/');
  return {
    category,
    slug,
    title: post.data.title,
    date: post.data.date.toISOString(), // Date -> ISO文字列に変換してpropsへ
  };
});
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;600;700&family=Noto+Serif+JP:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="site-wrapper">
    <header class="global-header">
      <div class="header-left">
        <!-- ロゴクリックでトップページへ遷移（旧 router-link を通常の <a> に置き換え） -->
        <a href="/" class="logo clickable" title="トップページへ">
          <i class="fa-solid fa-pen-nib"></i> <span>Kazuki's Blog </span>
        </a>
      </div>

      <div class="header-ticker">
        <div class="ticker-wrapper">
          <div class="ticker-content" id="ticker-content">
            【お知らせ】このサイトは順次更新しています。自作したAstro+Vue v3の環境にコンテンツを公開しています&nbsp;&nbsp;&nbsp;&nbsp
          </div>
        </div>
        <!-- 再生 / 停止 切り替えボタン（単純なトグルのみなのでVueアイランド化はせず、素のJSで実装） -->
        <button
          class="ticker-toggle-btn"
          id="ticker-toggle-btn"
          title="スクロールを一時停止"
        >
          <i class="fa-solid fa-pause" id="ticker-toggle-icon"></i>
        </button>
      </div>

      <div class="header-right">
        <button class="nav-btn"><i class="fa-solid fa-list-ul"></i> List</button>
        <button class="nav-btn"><i class="fa-regular fa-bell"></i> Notifications</button>
        <a href="/profile" class="icon-btn" title="プロフィール">
          <i class="fa-regular fa-user"></i>
        </a>
        <div class="user-icon"><i class="fa-regular fa-circle-user"></i></div>
      </div>
    </header>

    <div class="app-container">
      <Sidebar articles={articles} currentPath={Astro.url.pathname} client:load />

      <!-- メイン表示エリア -->
      <!-- 旧 <router-view /> の位置に、Astroでは <slot /> を使ってページごとの中身を差し込む -->
      <main class="content-area">
        <slot />
      </main>
    </div>

    <script>
      // ヘッダーティッカーの再生/停止トグル（旧 App.vue の isPlaying / toggleTicker を移植）
      // 状態がこの1箇所でしか使われず、他コンポーネントと共有する必要もないため
      // Vueアイランド化はせず、最小限の素のJavaScriptで実装している
      const tickerContent = document.getElementById('ticker-content');
      const toggleBtn = document.getElementById('ticker-toggle-btn');
      const toggleIcon = document.getElementById('ticker-toggle-icon');

      let isPlaying = true;

      toggleBtn?.addEventListener('click', () => {
        isPlaying = !isPlaying;
        tickerContent?.classList.toggle('paused', !isPlaying);
        toggleIcon?.classList.toggle('fa-pause', isPlaying);
        toggleIcon?.classList.toggle('fa-play', !isPlaying);
        toggleBtn.title = isPlaying ? 'スクロールを一時停止' : 'スクロールを再開';
      });
    </script>
  </body>
</html>

<style>
  /* ===== 図書館テーマ：デザイントークン ===== */
  :global(:root) {
    --color-bg: #ede6d6; /* 経年紙の背景 */
    --color-paper: #f5f0e3; /* 開いたページ（コンテンツ領域） */
    --color-wood-dark: #2b2016; /* ウォールナット材（ヘッダー） */
    --color-wood-mid: #4a3826; /* ウォールナット材（サイドバー） */
    --color-brass: #cba86b; /* 真鍮 */
    --color-brass-line: rgba(176, 141, 87, 0.35); /* 真鍮の罫線 */
    --color-lamp-green: #6fa88f; /* 閲覧室ランプのガラス */
    --color-ink: #2a2118; /* 本文インク */
    --color-ink-muted: #6f6150; /* 補足テキスト */
    --font-display: 'Shippori Mincho', serif;
    --font-body: 'Noto Serif JP', serif;
  }

  /* 全体レイアウト */
  .site-wrapper {
    display: flex;
    flex-direction: column;
    width: 100vw;
    height: 100vh;
    font-family: var(--font-body);
    color: var(--color-ink);
    background-color: var(--color-bg);
    box-sizing: border-box;
    margin: 0;
  }

  *,
  *::before,
  *::after {
    box-sizing: inherit;
  }

  /* ヘッダー（書架の上端をイメージしたウォールナット材） */
  .global-header {
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;
    background-color: var(--color-wood-dark);
    border-bottom: 2px solid var(--color-brass);
    flex-shrink: 0;
    gap: 16px;
  }

  .header-left .logo {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    white-space: nowrap;
    text-decoration: none;
    color: var(--color-paper);
    display: flex;
    align-items: center;
    gap: 8px;
    letter-spacing: 0.02em;
  }

  .header-left .logo i {
    color: var(--color-brass);
  }

  .header-left .logo.clickable {
    cursor: pointer;
    user-select: none;
  }
  .header-left .logo.clickable:hover {
    opacity: 0.8;
  }

  /* ヘッダーの中央ティッカーエリア */
  .header-ticker {
    flex: 1;
    overflow: hidden;
    font-size: 14px;
    color: rgba(237, 230, 214, 0.85);
    background-color: rgba(237, 230, 214, 0.07);
    border: 1px solid var(--color-brass-line);
    padding: 4px 32px 4px 8px; /* 右側にボタン分のスペース（32px）を確保 */
    border-radius: 2px;
    white-space: nowrap;
    position: relative;
    display: flex;
    align-items: center;
  }

  .ticker-wrapper {
    display: inline-block;
    width: 100%;
    overflow: hidden;
  }

  /* アニメーション用コンテンツ */
  .ticker-content {
    display: inline-block;
    white-space: nowrap;
    padding-left: 100%;
    animation: ticker-scroll 60s linear infinite;
  }

  /* 停止状態のクラス（isPlaying === false の時に適用） */
  .ticker-content.paused {
    animation-play-state: paused;
  }

  /* 右側に固定配置する切り替えボタン */
  .ticker-toggle-btn {
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-brass);
    font-size: 11px;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
    transition: background-color 0.2s, color 0.2s;
    z-index: 2;
  }

  .ticker-toggle-btn:hover {
    background-color: rgba(237, 230, 214, 0.12);
    color: var(--color-paper);
  }

  /* 右から左へ移動させるアニメーション定義 */
  @keyframes ticker-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-100%);
    }
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 14px;
    white-space: nowrap;
  }

  .nav-btn,
  .icon-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 13px;
    color: rgba(237, 230, 214, 0.75);
    display: flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
  }

  .nav-btn:hover,
  .icon-btn:hover {
    color: var(--color-brass);
  }

  .user-icon {
    font-size: 18px;
    color: var(--color-brass);
  }

  /* メインコンテナ */
  .app-container {
    display: flex;
    flex: 1;
    overflow: hidden;
  }

  /* メインコンテンツ表示域（開いた本のページをイメージ） */
  .content-area {
    flex: 1;
    padding: 32px 48px;
    overflow-y: auto;
    background-color: var(--color-paper);
  }

  .content-area :global(h1) {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-ink);
  }

  .content-area :global(a) {
    color: var(--color-lamp-green);
  }
</style>
